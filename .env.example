# WinStream local packaging / signing (copy to .env - never commit .env)
#
# Absolute path to the secrets tree used by the packaging scripts. Required.
# Windows package signing material lives under <WINSTREAM_SECRETS_DIR>/windows/.

WINSTREAM_SECRETS_DIR=C:\path\to\your\.secrets

# Optional overrides (defaults are derived from WINSTREAM_SECRETS_DIR)
# WINSTREAM_PACKAGE_CERTIFICATE_PATH=${WINSTREAM_SECRETS_DIR}\windows\winstream-package.pfx
# WINSTREAM_PACKAGE_CERTIFICATE_CER_PATH=${WINSTREAM_SECRETS_DIR}\windows\winstream-package.cer
WINSTREAM_PACKAGE_CERTIFICATE_PASSWORD=

# Must exactly match the PFX certificate subject (Distinguished Name).
# Default matches the self-signed cert created by scripts/ensure-package-certificate.ps1
WINSTREAM_PACKAGE_PUBLISHER=CN=WinStream Dev, O=Local Development, C=US
WINSTREAM_PACKAGE_PUBLISHER_DISPLAY_NAME=WinStream Dev

# Build defaults
WINSTREAM_PLATFORM=x64
WINSTREAM_CONFIGURATION=Release
