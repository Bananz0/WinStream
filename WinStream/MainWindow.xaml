<Window
    x:Class="WinStream.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinStream.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinStream">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
            <Style x:Key="HintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: identity on the left, live session state on the right -->
        <Border Grid.Row="0"
                Padding="20,14"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="Assets/Square44x44Logo.scale-200.png"
                       Width="32"
                       Height="32"
                       VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="WinStream" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Send this PC's audio to AirPlay speakers"
                               Style="{StaticResource HintTextStyle}"/>
                </StackPanel>

                <Border Grid.Column="2"
                        x:Name="statusPill"
                        VerticalAlignment="Center"
                        CornerRadius="14"
                        Padding="12,6"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="statusDot"
                                 Width="8"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="statusPillText"
                                   Text="Not connected"
                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Padding="20"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" MaxWidth="860">

                <InfoBar x:Name="messageBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Error"/>

                <InfoBar x:Name="macHintBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational"
                         Title="Streaming to a Mac?"
                         Message="On the Mac, open System Settings &gt; General &gt; AirDrop &amp; Handoff, set AirPlay Receiver to &quot;Everyone&quot; or &quot;Anyone on the same network&quot;, and turn off the required password."
                         CloseButtonClick="MacHintBar_CloseButtonClick"/>

                <!-- Step 1: what to send -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Audio source" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="captureDeviceComboBox"
                                      Grid.Column="0"
                                      Header="Capture from"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="CaptureDeviceComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CaptureEndpointViewModel">
                                        <StackPanel Padding="0,4">
                                            <TextBlock Text="{x:Bind Name}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Detail}"
                                                       Visibility="{x:Bind DetailVisibility}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="refreshButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Click="RefreshButton_Click"
                                    ToolTipService.ToolTip="Reload audio devices"
                                    AutomationProperties.Name="Reload audio devices">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Level"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource HintTextStyle}"/>
                            <ProgressBar x:Name="captureLevelBar"
                                         Grid.Column="1"
                                         Minimum="0"
                                         Maximum="1"
                                         Height="6"
                                         VerticalAlignment="Center"/>
                            <TextBlock x:Name="captureStatusText"
                                       Grid.Column="2"
                                       Text="Idle"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Grid>

                        <ToggleSwitch x:Name="monitorCaptureToggle"
                                      Header="Also play through this PC's speakers"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="MonitorCaptureToggle_Toggled"/>
                    </StackPanel>
                </Border>

                <!-- Step 2: where to send it -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="AirPlay devices" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="deviceCountText"
                                           Text="Looking for devices…"
                                           Style="{StaticResource HintTextStyle}"/>
                            </StackPanel>

                            <AutoSuggestBox x:Name="filterBox"
                                            Grid.Column="1"
                                            Width="200"
                                            VerticalAlignment="Center"
                                            QueryIcon="Find"
                                            PlaceholderText="Search"
                                            TextChanged="FilterBox_TextChanged"/>

                            <Button x:Name="searchButton"
                                    Grid.Column="2"
                                    Content="Scan"
                                    MinWidth="80"
                                    VerticalAlignment="Center"
                                    Click="SearchButton_Click"/>
                        </Grid>

                        <ListView Grid.Row="1"
                                  x:Name="devicesList"
                                  ItemsSource="{x:Bind DeviceList}"
                                  SelectionMode="None"
                                  MaxHeight="320"
                                  Margin="-4,0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceViewModel">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0"
                                                  Glyph="&#xE7F5;"
                                                  FontSize="18"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Visibility="{x:Bind ConnectedBadgeVisibility, Mode=OneWay}"
                                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Connected"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}"
                                                       Visibility="{x:Bind StatusVisibility, Mode=OneWay}"
                                                       Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <ProgressRing Width="18"
                                                          Height="18"
                                                          IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                          Visibility="{x:Bind BusyVisibility, Mode=OneWay}"/>
                                            <Button Content="{x:Bind ActionLabel, Mode=OneWay}"
                                                    Style="{x:Bind ActionButtonStyle, Mode=OneWay}"
                                                    IsEnabled="{x:Bind IsActionEnabled, Mode=OneWay}"
                                                    MinWidth="96"
                                                    Click="ConnectButton_Click"/>
                                            <Button Click="InfoButton_Click"
                                                    ToolTipService.ToolTip="Device details"
                                                    AutomationProperties.Name="Device details">
                                                <FontIcon Glyph="&#xE946;" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="2"
                                    x:Name="emptyStatePanel"
                                    Spacing="4"
                                    Padding="0,20,0,24"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="No AirPlay devices found"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Make sure the receiver is on the same network and awake."
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource HintTextStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 3: how loud -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Volume" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE993;"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Slider x:Name="streamVolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="1"
                                    Value="70"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Receiver volume"
                                    ValueChanged="StreamVolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="streamVolumeText"
                                       Grid.Column="2"
                                       Text="70%"
                                       Width="44"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Sets the receiver's volume. Applied when you connect."
                                   Style="{StaticResource HintTextStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Rarely used, so it stays collapsed -->
                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Header="Advanced">
                    <StackPanel Spacing="16" Padding="0,8,0,4">
                        <StackPanel Spacing="4">
                            <ComboBox x:Name="captureModeComboBox"
                                      Header="Capture method"
                                      MinWidth="220"
                                      SelectionChanged="CaptureModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="System loopback" Tag="Loopback"/>
                                <ComboBoxItem Content="Virtual audio driver" Tag="VirtualDriver"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="System loopback works out of the box. The virtual driver must be installed separately and is not included in the Store version."/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
