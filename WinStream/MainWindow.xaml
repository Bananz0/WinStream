<Window
    x:Class="WinStream.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinStream.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinStream">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
            <Style x:Key="HintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: identity on the left, live session state on the right -->
        <Border Grid.Row="0"
                Padding="20,14"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="Assets/Square44x44Logo.scale-200.png"
                       Width="32"
                       Height="32"
                       VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="WinStream" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Send this PC's audio to AirPlay speakers"
                               Style="{StaticResource HintTextStyle}"/>
                </StackPanel>

                <Border Grid.Column="2"
                        x:Name="statusPill"
                        VerticalAlignment="Center"
                        CornerRadius="14"
                        Padding="12,6"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="statusDot"
                                 Width="8"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="statusPillText"
                                   Text="Not connected"
                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Padding="20"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" MaxWidth="860">

                <InfoBar x:Name="messageBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Error"/>

                <InfoBar x:Name="macHintBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational"
                         Title="Streaming to a Mac?"
                         Message="On the Mac, set AirPlay Receiver to Everyone (or anyone on the same network) and turn off the required password. The first connect asks for the AirPlay code once so later sessions can skip Accept."
                         CloseButtonClick="MacHintBar_CloseButtonClick"/>

                <!-- Step 1: what to send -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Audio source" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Choose how WinStream captures sound from this PC."
                                       Style="{StaticResource HintTextStyle}"/>
                        </StackPanel>

                        <Border Padding="14"
                                CornerRadius="8"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="2"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36"
                                            Height="36"
                                            CornerRadius="18"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                        <FontIcon Glyph="&#xE995;"
                                                  FontSize="16"
                                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="System audio"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Capture the sound already playing through Windows."
                                                   Style="{StaticResource HintTextStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            CornerRadius="10"
                                            Padding="8,3"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                        <TextBlock Text="Selected"
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                    </Border>
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="captureDeviceComboBox"
                                              Grid.Column="0"
                                              Header="Playback device to capture"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="CaptureDeviceComboBox_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CaptureEndpointViewModel">
                                                <StackPanel Padding="0,4">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind Detail}"
                                                               Visibility="{x:Bind DetailVisibility}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="refreshButton"
                                            Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Click="RefreshButton_Click"
                                            ToolTipService.ToolTip="Reload audio devices"
                                            AutomationProperties.Name="Reload audio devices">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                    </Button>
                                </Grid>

                                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Level"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource HintTextStyle}"/>
                                    <ProgressBar x:Name="captureLevelBar"
                                                 Grid.Column="1"
                                                 Minimum="0"
                                                 Maximum="1"
                                                 Height="6"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock x:Name="captureStatusText"
                                               Grid.Column="2"
                                               Text="Idle"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                </Grid>

                                <ToggleSwitch x:Name="monitorCaptureToggle"
                                              Header="Also play through this PC's speakers"
                                              OnContent="On"
                                              OffContent="Off"
                                              Toggled="MonitorCaptureToggle_Toggled"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="virtualDriverCard"
                                Padding="14"
                                CornerRadius="8"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource ControlFillColorDisabledBrush}"
                                AutomationProperties.Name="WinStream virtual audio driver"
                                AutomationProperties.HelpText="Optional audio source. Download and install it to unlock this source.">
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="36"
                                        Height="36"
                                        CornerRadius="18"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <FontIcon x:Name="driverStateIcon"
                                              Glyph="&#xE72E;"
                                              FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="WinStream virtual audio"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <Border CornerRadius="9"
                                                Padding="7,2"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <TextBlock x:Name="driverStateBadge"
                                                       Text="Locked"
                                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="driverStatusText"
                                               Text="Install the optional driver for a dedicated WinStream audio output."
                                               Style="{StaticResource HintTextStyle}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>

                                <Button x:Name="driverActionButton"
                                        Grid.Column="2"
                                        MinWidth="142"
                                        VerticalAlignment="Center"
                                        Content="Download &amp; install"
                                        Click="DriverActionButton_Click"
                                        AutomationProperties.Name="Download and install WinStream virtual audio driver"
                                        AutomationProperties.HelpText="Downloads the development driver and asks for administrator approval before installation."/>

                                <StackPanel x:Name="driverProgressPanel"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Spacing="4"
                                            Visibility="Collapsed">
                                    <ProgressBar x:Name="driverProgressBar"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 AutomationProperties.Name="Virtual audio driver download progress"/>
                                    <TextBlock x:Name="driverProgressText"
                                               Text="Preparing…"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Step 2: where to send it -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="AirPlay devices" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="deviceCountText"
                                           Text="Looking for devices…"
                                           Style="{StaticResource HintTextStyle}"/>
                            </StackPanel>

                            <AutoSuggestBox x:Name="filterBox"
                                            Grid.Column="1"
                                            Width="200"
                                            VerticalAlignment="Center"
                                            QueryIcon="Find"
                                            PlaceholderText="Search"
                                            TextChanged="FilterBox_TextChanged"/>

                            <Button x:Name="searchButton"
                                    Grid.Column="2"
                                    Content="Scan"
                                    MinWidth="80"
                                    VerticalAlignment="Center"
                                    Click="SearchButton_Click"/>
                        </Grid>

                        <Border Grid.Row="1"
                                Padding="14,12"
                                CornerRadius="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="18"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE895;"
                                              FontSize="16"
                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Auto-connect"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="autoConnectDescriptionText"
                                               Text="Pick a preferred device with the star, or connect once to set it."
                                               Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>

                                <ToggleSwitch x:Name="autoConnectToggle"
                                              Grid.Column="2"
                                              VerticalAlignment="Center"
                                              OnContent="On"
                                              OffContent="Off"
                                              Toggled="AutoConnectToggle_Toggled"
                                              AutomationProperties.Name="Auto-connect to the preferred device"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Padding="14,12"
                                CornerRadius="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="18"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7E8;"
                                              FontSize="16"
                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Launch when I sign in"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="launchAtStartupDescriptionText"
                                               Text="Start WinStream in the tray after Windows login."
                                               Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>

                                <ToggleSwitch x:Name="launchAtStartupToggle"
                                              Grid.Column="2"
                                              VerticalAlignment="Center"
                                              OnContent="On"
                                              OffContent="Off"
                                              Toggled="LaunchAtStartupToggle_Toggled"
                                              AutomationProperties.Name="Launch WinStream when I sign in to Windows"/>
                            </Grid>
                        </Border>

                        <ListView Grid.Row="3"
                                  x:Name="devicesList"
                                  ItemsSource="{x:Bind DeviceList}"
                                  SelectionMode="None"
                                  MaxHeight="320"
                                  Margin="-4,0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceViewModel">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0"
                                                  Glyph="&#xE7F5;"
                                                  FontSize="18"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Visibility="{x:Bind PreferredBadgeVisibility, Mode=OneWay}"
                                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Preferred"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                                </Border>
                                                <Border Visibility="{x:Bind ConnectedBadgeVisibility, Mode=OneWay}"
                                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Connected"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}"
                                                       Visibility="{x:Bind StatusCaptionVisibility, Mode=OneWay}"
                                                       Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>
                                            <Border Visibility="{x:Bind StatusBannerVisibility, Mode=OneWay}"
                                                    Background="{x:Bind StatusBannerBackground, Mode=OneWay}"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="0,6,0,0">
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE7BA;"
                                                                  FontSize="12"
                                                                  Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                                  VerticalAlignment="Center"/>
                                                        <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind StatusDetail, Mode=OneWay}"
                                                               Visibility="{x:Bind StatusDetailVisibility, Mode=OneWay}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <ProgressRing Width="18"
                                                          Height="18"
                                                          IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                          Visibility="{x:Bind BusyVisibility, Mode=OneWay}"/>
                                            <Button Click="PreferButton_Click"
                                                    ToolTipService.ToolTip="{x:Bind PreferToolTip, Mode=OneWay}"
                                                    AutomationProperties.Name="{x:Bind PreferAutomationName, Mode=OneWay}"
                                                    IsEnabled="{x:Bind IsActionEnabled, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind PreferGlyph, Mode=OneWay}" FontSize="14"/>
                                            </Button>
                                            <Button Content="{x:Bind ActionLabel, Mode=OneWay}"
                                                    Style="{x:Bind ActionButtonStyle, Mode=OneWay}"
                                                    IsEnabled="{x:Bind IsActionEnabled, Mode=OneWay}"
                                                    MinWidth="96"
                                                    Click="ConnectButton_Click"/>
                                            <Button Click="InfoButton_Click"
                                                    ToolTipService.ToolTip="Device details and forget pairing"
                                                    AutomationProperties.Name="Device details and forget pairing">
                                                <FontIcon Glyph="&#xE946;" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="4"
                                    x:Name="emptyStatePanel"
                                    Spacing="4"
                                    Padding="0,20,0,24"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="No AirPlay devices found"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Make sure the receiver is on the same network and awake."
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource HintTextStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- WinStream Link (feature-flagged; default hidden) -->
                <Border x:Name="linkSinkCard"
                        Style="{StaticResource CardBorderStyle}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="linkCardTitle"
                                       Text="WinStream Link"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="linkCardHint"
                                       Text="Companion path for the lowest latency WinStream can measure. Requires a LinkRx companion outside this app. AirPlay and Link cannot run at the same time."
                                       Style="{StaticResource HintTextStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox x:Name="sinkModeComboBox"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="SinkModeComboBox_SelectionChanged"
                                  AutomationProperties.Name="Sink mode"/>
                        <StackPanel x:Name="linkConnectPanel" Spacing="8" Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="linkDiscoveryComboBox"
                                          Grid.Column="0"
                                          Header="Discovered companions"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="No companions found yet"
                                          SelectionChanged="LinkDiscoveryComboBox_SelectionChanged"
                                          AutomationProperties.Name="Discovered Link companions"/>
                                <Button x:Name="linkScanButton"
                                        Grid.Column="1"
                                        Content="Scan"
                                        VerticalAlignment="Bottom"
                                        Click="LinkScanButton_Click"
                                        AutomationProperties.Name="Scan for Link companions"/>
                            </Grid>
                            <TextBox x:Name="linkHostTextBox"
                                     Header="Companion IP"
                                     PlaceholderText="192.168.1.50"
                                     AutomationProperties.Name="Link companion IP"/>
                            <PasswordBox x:Name="linkPinBox"
                                         Header="Link PIN"
                                         AutomationProperties.Name="Link PIN"/>
                            <Button x:Name="linkConnectButton"
                                    Content="Connect Link"
                                    Click="LinkConnectButton_Click"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Connect or disconnect Link"/>
                            <TextBlock x:Name="linkStatusText"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="linkStatusDetailText"
                                       Style="{StaticResource HintTextStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Playback responsiveness + audio fidelity -->
                <Border x:Name="streamingQualityCard" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Streaming quality" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Delay and conversion are separate. Changing a setting while streaming reconnects automatically."
                                       Style="{StaticResource HintTextStyle}"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Playback responsiveness"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Click="PlaybackResponsivenessInfo_Click"
                                        ToolTipService.ToolTip="About playback responsiveness"
                                        AutomationProperties.Name="About playback responsiveness"
                                        Padding="6,4">
                                    <FontIcon Glyph="&#xE946;" FontSize="14"/>
                                </Button>
                            </Grid>
                            <ComboBox x:Name="playbackResponsivenessComboBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="PlaybackResponsivenessComboBox_SelectionChanged"
                                      AutomationProperties.Name="Playback responsiveness"/>
                            <TextBlock x:Name="playbackResponsivenessHintText"
                                       Style="{StaticResource HintTextStyle}"/>
                            <InfoBar x:Name="extremePressureBar"
                                     IsOpen="False"
                                     IsClosable="False"
                                     Severity="Error">
                                <InfoBar.ActionButton>
                                    <Button Content="Use Experimental"
                                            Click="ExtremePressureBar_UseExperimentalClick"/>
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Audio fidelity"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Click="AudioFidelityInfo_Click"
                                        ToolTipService.ToolTip="About audio fidelity"
                                        AutomationProperties.Name="About audio fidelity"
                                        Padding="6,4">
                                    <FontIcon Glyph="&#xE946;" FontSize="14"/>
                                </Button>
                            </Grid>
                            <ComboBox x:Name="audioFidelityComboBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="AudioFidelityComboBox_SelectionChanged"
                                      AutomationProperties.Name="Audio fidelity"/>
                            <TextBlock x:Name="audioFidelityHintText"
                                       Style="{StaticResource HintTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 3: how loud -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Volume" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE993;"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Slider x:Name="streamVolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="1"
                                    Value="100"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Receiver volume"
                                    ValueChanged="StreamVolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="streamVolumeText"
                                       Grid.Column="2"
                                       Text="100%"
                                       Width="44"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Sets the receiver's volume. Applied when you connect."
                                   Style="{StaticResource HintTextStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
