<Window
    x:Class="WinStream.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinStream.Network"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinStream">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="16,12,16,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="filterTextBox"
                     PlaceholderText="Search devices..."
                     TextChanged="FilterTextBox_TextChanged"/>

            <Button x:Name="refreshButton"
                    Grid.Column="1"
                    ToolTipService.ToolTip="Refresh"
                    Click="RefreshButton_Click">
                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
            </Button>

            <ProgressRing x:Name="scanProgressRing"
                          Grid.Column="2"
                          Width="20" Height="20"
                          IsActive="False"/>
        </Grid>

        <!-- Device list -->
        <ScrollViewer Grid.Row="1" Padding="16,4,16,8">
            <ItemsRepeater x:Name="devicesRepeater" ItemsSource="{x:Bind DeviceList}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:DeviceInfo">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Device icon -->
                                <Border Width="44" Height="44"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind DeviceTypeGlyph}"
                                              FontSize="22"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>

                                <!-- Device info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{x:Bind Manufacturer}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{x:Bind Model}"/>
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind IPAddress}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>

                                <!-- Connect area -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            Spacing="8" VerticalAlignment="Center">
                                    <ProgressRing Width="20" Height="20"
                                                  IsActive="{x:Bind IsConnecting, Mode=OneWay}"
                                                  Visibility="{x:Bind ConnectingVisibility, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Button Tag="{x:Bind}"
                                            Content="{x:Bind ConnectButtonText, Mode=OneWay}"
                                            Click="ConnectButton_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            MinWidth="90"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="audioSourceTextBlock"
                           Text="Audio source: not streaming"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="streamingDot"
                             Width="8" Height="8"
                             Fill="{ThemeResource SystemFillColorSuccessBrush}"
                             Visibility="Collapsed"/>
                    <TextBlock x:Name="streamingLabel"
                               Text="Live"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
